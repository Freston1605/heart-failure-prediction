# Environment variables for heart-failure-prediction
#
# Every variable below is OPTIONAL — the app boots with safe fallbacks when
# they are unset. None is required for a normal local run or the Cloud deploy.
# Copy to `.env` (gitignored) only if you need to override a default.
#
# NOTE: the MLflow tracking URI is NOT set here — it is configured
# programmatically by heart.tracking.mlflow_store.configure_tracking().

# --- Optional operator overrides (path seams; used for demos/tests) ---------
# Explore page dataset path override (default: committed data/raw/heart.csv).
#EXPLORE_DATA_PATH=/path/to/heart.csv
# Data Methods report directory override (default: committed data-methods dir).
#DATA_METHODS_DIR=/path/to/data-methods
# MLflow runs-tracking directory override (default: the mlflow_store default).
#RUNS_TRACKING_DIR=/path/to/mlruns

# --- Logging tuning ---------------------------------------------------------
# Verbosity (default: INFO).
#HEART_LOG_LEVEL=INFO
# Log format: text | json (default: text locally; use json for the deployed app).
#HEART_LOG_FORMAT=text

# --- MLflow UI --------------------------------------------------------------
# Port for the local MLflow tracking UI (default: 5000).
#MLFLOW_UI_PORT=5000
